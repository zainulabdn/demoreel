    "skills/demoreel",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:unit": "DEMOREEL_E2E=0 node --test",
    "demo": "node skills/demoreel/scripts/demoreel.mjs record examples/lumen/demo.reel.json"
  },
  "keywords": [
    "demo-video",
    "screen-recording",
    "agent-skill",
    "claude-code",
    "codex",
    "product-demo",
    "voice-over",
    "gif",
    "mp4"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zainulabdn/demoreel.git"
  },
  "homepage": "https://github.com/zainulabdn/demoreel",
