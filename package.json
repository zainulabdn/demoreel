{
  "name": "demoreel",
  "version": "0.2.0",
  "description": "A polished demo video of your real web app, recorded by your coding agent, with an optional voice-over. Zero dependencies: just Node and the Chrome you already have.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "demoreel": "skills/demoreel/scripts/demoreel.mjs"
  },
